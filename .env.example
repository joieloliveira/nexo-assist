# Copy this file to .env at the repository root (never commit .env)
PORT=3001
WEB_ORIGIN=http://localhost:3000
MONGODB_URI=mongodb://127.0.0.1:27017/nexo_assist
# Replace with a randomly generated value of at least 32 characters
JWT_SECRET=replace-this-with-a-random-secret-of-at-least-32-characters
# Demo mode only: accepts any non-empty password for seeded users
DEMO_AUTH_ENABLED=true
# To be configured when the AI agent is implemented
LLM_API_KEY=
